  _clickMessage: "\uC2AC\uB77C\uC784\uC744 \uD130\uCE58\uD574 \uBCF4\uC138\uC694!"
  _pointMessage: "\uD3EC\uC778\uD2B8\uB97C \uD130\uCE58\uD574 \uD655\uC778\uD574
    \uBCF4\uC138\uC694!"
  _dragMessage: "\uC2AC\uB77C\uC784\uC744 \uB4DC\uB798\uADF8\uD574 \uBCF4\uC138\uC694!"
  _mergeMessage: "\uAC19\uC740 \uB808\uBCA8\uC758 \uC2AC\uB77C\uC784\uC744 \uD569\uCCD0
    \uBCF4\uC138\uC694!"
  _systemUpgradeCarouselMessage: "슬라임 업그레이드는 모든 포인트 획득량을 1%씩 올려 줘요!"
  _spawnPoolButtonMessage: "\uD559\uC790 \uC2AC\uB77C\uC784\uC744 \uB20C\uB7EC \uC790\uC5F0
    \uC0DD\uC131 \uD655\uB960\uC744 \uD655\uC778\uD574 \uBCF4\uC138\uC694!"
  _autoSpawnToggleMessage: "\uAC00\uCC60\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB294 \uC790\uB3D9
    \uC2A4\uD3F0\uC744 OFF\uB85C \uB450\uBA74 \uBE48 \uC790\uB9AC\uAC00 \uC720\uC9C0\uB3FC\uC694.
    \uBC84\uD2BC\uC744 \uB20C\uB7EC OFF\uB85C \uBC14\uAFD4 \uBCF4\uC138\uC694!"
  _gachaMakeRoomMessage: "\uC720\uCE58\uC6D0\uC774 \uAC00\uB4DD \uCC3C\uC5B4\uC694.
    \uD45C\uC2DC\uB41C \uAC19\uC740 \uB808\uBCA8 \uC2AC\uB77C\uC784\uC744 \uD569\uCCD0
    \uC790\uB9AC\uB97C \uD558\uB098 \uB9CC\uB4E4\uC5B4 \uC8FC\uC138\uC694!"
  _gachaButtonMessage: "\uC900\uBE44\uB410\uC5B4\uC694! \uC774 \uBC84\uD2BC\uC744
    \uB20C\uB7EC \uAC00\uCC60\uAD8C\uC744 \uC0AC\uC6A9\uD574 \uBCF4\uC138\uC694!"
  _autoMergeButtonMessage: "\uC790\uB3D9 \uD569\uC131 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBCF4\uC138\uC694!"
  _displayRoomButtonMessage: "\uD558\uB2E8 \uD328\uB110 \uC804\uD658 \uBC84\uD2BC\uC744
    \uB20C\uB7EC \uC774\uB3D9 \uD328\uB110\uC744 \uC5F4\uC5B4 \uBCF4\uC138\uC694!"
  _displayRoomSendButtonMessage: "\uC7A5\uC2DD\uC7A5\uC73C\uB85C \uBCF4\uB0B4\uAE30
    \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBCF4\uC138\uC694!"
  _displayRoomSelectSlimeMessage: "\uC7A5\uC2DD\uC7A5\uC73C\uB85C \uBCF4\uB0BC \uC2AC\uB77C\uC784\uC744
    \uC120\uD0DD\uD558\uC138\uC694!"
  _displayRoomEnterMessage: "\uC7A5\uC2DD\uC7A5\uC73C\uB85C \uC774\uB3D9\uD574 \uBCF4\uC138\uC694!"
  _displayRoomInfoMessage: "\uC2AC\uB77C\uC784\uC744 \uD130\uCE58\uD558\uBA74 \uC774\uB984\uACFC
    \uC815\uBCF4\uB97C \uBCFC \uC218 \uC788\uC5B4\uC694!"
  _displayRoomInfoSummaryMessage: "\uC5EC\uAE30\uC11C \uC2AC\uB77C\uC784\uC758 \uC774\uB984\uACFC
    \uBC88\uD638 \\n \uD55C \uC904 \uC124\uBA85\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694!"
  _displayRoomObserveMessage: "\uAD00\uCC30\uD558\uAE30\uB97C \uB204\uB974\uBA74
    UI \uC5C6\uC774 \uC2AC\uB77C\uC784\uC744 \uC790\uC138\uD788 \uBCFC \uC218 \uC788\uC5B4\uC694!"
  _displayRoomTakeOutMessage: "\uAEBC\uB0B4\uAE30\uB85C \uC720\uCE58\uC6D0\uC5D0
    \uB3CC\uB824\uBCF4\uB0BC \uC218 \uC788\uC5B4\uC694. \uC720\uCE58\uC6D0\uC774
    \uAC00\uB4DD \uCC28\uBA74 \uAEBC\uB0BC \uC218 \uC5C6\uC5B4\uC694!"
  _displayRoomCloseMessage: "\uC124\uBA85\uC744 \uD655\uC778\uD588\uC73C\uBA74 \uB2EB\uAE30
    \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBCF4\uC138\uC694!"
  _dialogues:
  - _id: 0
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC5B4\uC11C \uC640! \uC774\uACF3\uC740 \uBAAC\uC2A4\uD130 \uC720\uCE58\uC6D0\uC774\uC57C."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uBA3C\uC800 \uB208\uC55E\uC758 \uC2AC\uB77C\uC784\uACFC \uC778\uC0AC\uD574
        \uBCFC\uAE4C?"
  - _id: 1
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC798\uD588\uC5B4! \uC2AC\uB77C\uC784\uC744 \uD130\uCE58\uD558\uBA74
        \uD3EC\uC778\uD2B8\uB97C \uC5BB\uC744 \uC218 \uC788\uC5B4."
  - _id: 2
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC2AC\uB77C\uC784\uC740 \uB4DC\uB798\uADF8 \uC564 \uB4DC\uB86D\uC73C\uB85C
        \uC6D0\uD558\uB294 \uACF3\uC73C\uB85C \uC774\uB3D9\uC2DC\uD0AC \uC218 \uC788\uC5B4."
  - _id: 3
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uCD95\uD558\uD574! \uAC19\uC740 \uB808\uBCA8\uC758 \uC2AC\uB77C\uC784\uC744
        \uD569\uCE58\uBA74 \uB354 \uB192\uC740 \uB808\uBCA8\uC758 \uC2AC\uB77C\uC784\uC744
        \uB9CC\uB4E4 \uC218 \uC788\uC5B4."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC2AC\uB77C\uC784\uC740 \uAC00\uB9CC\uD788 \uB450\uC5B4\uB3C4 \uC77C\uC815
        \uC2DC\uAC04\uB9C8\uB2E4 \uC790\uB3D9\uC73C\uB85C \uD3EC\uC778\uD2B8\uB97C
        \uBC8C\uC5B4 \uC900\uB2E8\uB2E4."
  - _id: 4
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "아래 시스템 업그레이드에서 모든 슬라임의 포인트 획득량을 올릴 수 있어."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "슬라임 업그레이드 항목을 보여 줄게. 확인하고 다음 설명으로 넘어가 보자."
  - _id: 5
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uADF8\uB9AC\uACE0 \uC704\uC758 \uAC8C\uC774\uC9C0\uAC00 \uBAA8\uB450
        \uCC28\uBA74 \uC0C8\uB85C\uC6B4 \uC2AC\uB77C\uC784\uC774 \uC790\uB3D9\uC73C\uB85C
        \uB4F1\uC7A5\uD574."
  - _id: 6
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC774\uC81C \uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4! \uC2AC\uB77C\uC784\uB4E4\uC744
        \uC798 \uD0A4\uC6CC \uB098\uAC00 \uBCF4\uC790!"
  - _id: 7
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "5\uB808\uBCA8 \uC2AC\uB77C\uC784\uC744 \uD574\uAE08\uD574\uC11C
        \uC790\uC5F0 \uC0DD\uC131\uB418\uB294 \uC2AC\uB77C\uC784\uC758 \uC885\uB958\uAC00
        \uB298\uC5B4\uB0AC\uC5B4!"
  - _id: 8
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC0C1\uC704 \uC2AC\uB77C\uC784 \uB4F1\uC7A5 \uD655\uB960 \uC5C5\uADF8\uB808\uC774\uB4DC\uB85C
        \uB192\uC740 \uB4F1\uAE09 \uC2AC\uB77C\uC784\uC774 \uC790\uC5F0 \uC0DD\uC131\uB420
        \uD655\uB960\uC744 \uB192\uC77C \uC218 \uC788\uC5B4."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC5C5\uADF8\uB808\uC774\uB4DC \uB808\uBCA8\uC774 \uB354 \uB192\uC544\uC9C0\uBA74
        \uC790\uC5F0 \uC0DD\uC131\uB418\uB294 \uC2AC\uB77C\uC784\uC758 \uC885\uB958\uAC00
        \uB354 \uB2E4\uC591\uD574\uC9C8\uC9C0\uB3C4...?"
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC0C8\uB85C\uC6B4 \uC2AC\uB77C\uC784\uB4E4\uC744 \uB9CC\uB098\uBA74\uC11C
        \uC7AC\uBBF8\uC788\uAC8C \uC990\uACA8 \uC918!"
  - _id: 9
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "11\uB808\uBCA8 \uC2AC\uB77C\uC784\uC774 \uAE30\uB97C \uBAA8\uC73C\uACE0 \uC788\uC5B4! \uC720\uCE58\uC6D0\uC5D0 \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE30\uB824\uB098?"
  - _id: 10
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC0C8\uB85C\uC6B4 \uACF5\uAC04\uC778 \uC7A5\uC2DD\uC7A5\uC774 \uC5F4\uB838\uC5B4!
        \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uC2AC\uB77C\uC784\uC744 \uC804\uC2DC\uD574
        \uBCF4\uC790."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC7A5\uC2DD\uC7A5\uC5D0\uB294 \uAC19\uC740 \uC885\uB958\uC758 \uC2AC\uB77C\uC784\uC744
        \uD55C \uB9C8\uB9AC\uB9CC \uBCF4\uAD00\uD560 \uC218 \uC788\uC5B4."
  - _id: 11
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC7A5\uC2DD\uC7A5\uC5D0 \uC788\uB294 \uC2AC\uB77C\uC784\uC740 \uC5B4\uB5A4
        \uBC29\uBC95\uC73C\uB85C\uB3C4 \uD3EC\uC778\uD2B8\uB97C \uB9CC\uB4E4\uC9C0
        \uC54A\uC544. \uD3EC\uC778\uD2B8\uB97C \uC5BB\uC73C\uB824\uBA74 \uAEBC\uB0B4\uAE30\uB85C
        \uB2E4\uC2DC \uC720\uCE58\uC6D0\uC5D0 \uBCF4\uB0B4 \uC918."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC774\uC81C \uC7A5\uC2DD\uC7A5\uB3C4 \uB9C8\uC74C\uAECF \uAFB8\uBBF8\uBA74\uC11C
        \uC7AC\uBBF8\uC788\uAC8C \uC990\uACA8 \uC918!"
  - _id: 12
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC774 \uD655\uB960\uD45C\uC5D0\uC11C \uC9C0\uAE08 \uC790\uC5F0
        \uC0DD\uC131\uB420 \uC218 \uC788\uB294 \uC2AC\uB77C\uC784\uC758 \uC885\uB958\uC640
        \uAC01\uAC01\uC758 \uB4F1\uC7A5 \uD655\uB960\uC744 \uD655\uC778\uD560 \uC218
        \uC788\uC5B4."
  - _id: 13
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC720\uCE58\uC6D0 \uD558\uB298\uC774 \uC5F4\uB838\uC5B4! \uC774\uC81C \uBC30\uACBD\uC744 \uD558\uB298\uB85C \uBC14\uAFC0 \uC218 \uC788\uC5B4."
  - _id: 14
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC2AC\uB77C\uC784\uB4E4\uC740 \uADF8\uB300\uB85C \uC788\uACE0 \uBC30\uACBD\uB9CC \uBC14\uB00C\uB294 \uAC70\uC57C. \uB545\uACFC \uD558\uB298 \uC911\uC5D0 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCABD\uC744 \uACE8\uB77C \uBCF4\uC790."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC0C8\uB85C\uC6B4 \uD558\uB298\uC5D0\uC11C\uB3C4 \uC2AC\uB77C\uC784\uB4E4\uACFC
        \uC7AC\uBBF8\uC788\uAC8C \uC990\uACA8 \uC918!"
  - _id: 15
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "7\uB808\uBCA8 \uC2AC\uB77C\uC784\uC744 \uBC1C\uACAC\uD588\uB124!
        \uC774\uC81C \uC720\uCE58\uC6D0\uC758 \uC2AC\uB77C\uC784\uB4E4\uC774 \uAC00\uB054
        \uAC00\uCC60\uAD8C\uC744 \uB5A8\uC5B4\uB728\uB9B4 \uAC70\uC57C."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uD544\uB4DC\uC5D0 \uB5A8\uC5B4\uC9C4 \uAC00\uCC60\uAD8C\uC744 \uD130\uCE58\uD574\uC11C
        \uBAA8\uC544 \uC918. \uAC00\uCC60\uAD8C \uD55C \uC7A5\uC73C\uB85C \uC0C8\uB85C\uC6B4
        \uC2AC\uB77C\uC784 \uD55C \uB9C8\uB9AC\uB97C \uB9CC\uB0A0 \uC218 \uC788\uC5B4."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uCCAB \uCCB4\uD5D8\uC6A9\uC73C\uB85C \uAC00\uCC60\uAD8C \uD55C
        \uC7A5\uC744 \uC904\uAC8C. \uC6B4\uC774 \uC88B\uB2E4\uBA74 \uC870\uAE08 \uD2B9\uBCC4\uD55C
        \uC2AC\uB77C\uC784\uC744 \uB9CC\uB0A0\uC9C0\uB3C4...?"
  - _id: 16
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC0C8\uB85C\uC6B4 \uC2AC\uB77C\uC784\uC774 \uB098\uC654\uB124!
        \uAC00\uCC60\uAD8C\uC744 \uBAA8\uC73C\uBA74 \uC5EC\uAE30\uC11C \uB2E4\uC2DC
        \uB9CC\uB0A0 \uC218 \uC788\uC5B4."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uAC00\uCC60\uB97C \uC4F8 \uB54C\uB9CC \uC790\uB3D9 \uC2A4\uD3F0\uC744 \uAEBC \uB450\uACE0, \uD3C9\uC18C\uC5D0\uB294 \uB2E4\uC2DC \uCF1C \uB450\uC790!"
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uB354 \uBE60\uB974\uAC8C \uC2AC\uB77C\uC784\uB4E4\uC744 \uBAA8\uC73C\uACE0
        \uC131\uC7A5\uC2DC\uCF1C\uBCF4\uC790!"
  - _id: 17
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uB3C4\uAC10\uC5D0 \uC2AC\uB77C\uC784 10\uC885\uC774 \uBAA8\uC600\uC5B4! \uCD95\uD558\uB85C \uC790\uB3D9 \uD569\uC131\uC744 \uC5F4\uC5B4 \uC904\uAC8C."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC774 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74 \uAC19\uC740 \uB808\uBCA8 \uC2AC\uB77C\uC784\uB07C\uB9AC \uC54C\uC544\uC11C \uD569\uCCD0\uC838. \uB0AE\uC740 \uB808\uBCA8\uBD80\uD130 \uCC3E\uC544 \uC900\uB2E8\uB2E4."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uBA74 \uD55C \uBC88\uC5D0 \uD569\uCE58\uB294 \uC30D\uB3C4 \uB298\uC5B4\uB098. \uD55C\uBC88 \uB20C\uB7EC \uBCFC\uB798?"
  - _id: 18
    _lines:
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uB3C4\uAC10 12\uC885 \uB2EC\uC131! \uC774\uC81C \uD2F0\uCF13 \uD68C\uC218 \uBC84\uD2BC\uC744 \uC4F8 \uC218 \uC788\uC5B4."
    - _speaker: "\uD559\uC790 \uC2AC\uB77C\uC784"
      _message: "\uD544\uB4DC\uC5D0 \uB5A8\uC5B4\uC9C4 \uAC00\uCC60\uAD8C\uC744 \uD55C \uBC88\uC5D0 \uBAA8\uC544 \uC904\uAC8C."
  _backgroundMenuButtonMessage: "\uD558\uB2E8 \uD328\uB110 \uC804\uD658 \uBC84\uD2BC\uC744
    \uB20C\uB7EC \uC774\uB3D9 \uD328\uB110\uC744 \uC5F4\uC5B4 \uBCF4\uC790!"
  _backgroundButtonMessage: "\uC774 \uBC84\uD2BC\uC73C\uB85C \uBC30\uACBD\uC744 \uB545\uACFC \uD558\uB298 \uC911\uC5D0 \uACE0\uB97C \uC218 \uC788\uC5B4!"
