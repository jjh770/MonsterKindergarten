MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6b3287a7fd744c3a943047a2d8c10ab, type: 3}
  m_Name: TutorialContent
  m_EditorClassIdentifier: Assembly-CSharp::TutorialContent
  _clickMessage: "\uC2AC\uB77C\uC784\uC744 \uD130\uCE58\uD574 \uBCF4\uC138\uC694!"
  _pointMessage: "\uD3EC\uC778\uD2B8\uB97C \uD130\uCE58\uD574 \uD655\uC778\uD574
    \uBCF4\uC138\uC694!"
  _dragMessage: "\uC2AC\uB77C\uC784\uC744 \uB4DC\uB798\uADF8\uD574 \uBCF4\uC138\uC694!"
  _mergeMessage: "\uAC19\uC740 \uB808\uBCA8\uC758 \uC2AC\uB77C\uC784\uC744 \uD569\uCCD0
    \uBCF4\uC138\uC694!"
  _upgradeMessage: "\uC2AC\uB77C\uC784\uC744 \uB354 \uC131\uC7A5\uC2DC\uD0AC \uC218
    \uC788\uB294 \uC5C5\uADF8\uB808\uC774\uB4DC\uB3C4 \uC788\uC2B5\uB2C8\uB2E4!"
  _upgradePanelMessage: "\uB2EB\uAE30"
  _systemUpgradeCarouselMessage: "\uD558\uB2E8 \uD328\uB110\uC744 \uC88C\uC6B0\uB85C \uB3CC\uB824 \uBCF4\uC138\uC694!"
  _spawnPoolButtonMessage: "학자 슬라임을 눌러 자연 생성 확률을 확인해 보세요!"
  _displayRoomButtonMessage: "하단 패널 전환 버튼을 눌러 이동 패널을 열어 보세요!"
  _displayRoomSendButtonMessage: "장식장으로 보내기 버튼을 눌러 보세요!"
  _displayRoomSelectSlimeMessage: "장식장으로 보낼 슬라임을 선택하세요!"
  _displayRoomReopenMenuMessage: "장식장 아이콘을 다시 눌러 이동 메뉴를 열어 보세요!"
  _displayRoomEnterMessage: "장식장으로 이동해 보세요!"
  _displayRoomInfoMessage: "슬라임을 터치하면 이름과 정보를 볼 수 있어요!"
  _displayRoomInfoSummaryMessage: "여기서 슬라임의 이름과 번호, 한 줄 설명을 확인할 수 있어요!"
  _displayRoomObserveMessage: "관찰하기를 누르면 UI 없이 슬라임을 자세히 볼 수 있어요!"
  _displayRoomTakeOutMessage: "꺼내기로 유치원에 돌려보낼 수 있어요. 유치원이 가득 차면 꺼낼 수 없어요!"
  _displayRoomCloseMessage: "설명을 확인했으면 닫기 버튼을 눌러 보세요!"
  _dialogues:
  - _id: 0
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uC5B4\uC11C \uC640! \uC774\uACF3\uC740 \uBAAC\uC2A4\uD130 \uC720\uCE58\uC6D0\uC774\uC57C."
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uBA3C\uC800 \uB208\uC55E\uC758 \uC2AC\uB77C\uC784\uACFC \uC778\uC0AC\uD574
        \uBCFC\uAE4C?"
  - _id: 1
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uC798\uD588\uC5B4! \uC2AC\uB77C\uC784\uC744 \uD130\uCE58\uD558\uBA74
        \uD3EC\uC778\uD2B8\uB97C \uC5BB\uC744 \uC218 \uC788\uC5B4."
  - _id: 2
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uC2AC\uB77C\uC784\uC740 \uB4DC\uB798\uADF8 \uC564 \uB4DC\uB86D\uC73C\uB85C
        \uC6D0\uD558\uB294 \uACF3\uC73C\uB85C \uC774\uB3D9\uC2DC\uD0AC \uC218 \uC788\uC5B4."
  - _id: 3
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uCD95\uD558\uD574! \uAC19\uC740 \uB808\uBCA8\uC758 \uC2AC\uB77C\uC784\uC744
        \uD569\uCE58\uBA74 \uB354 \uB192\uC740 \uB808\uBCA8\uC758 \uC2AC\uB77C\uC784\uC744
        \uB9CC\uB4E4 \uC218 \uC788\uC5B4."
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uC2AC\uB77C\uC784\uC740 \uAC00\uB9CC\uD788 \uB450\uC5B4\uB3C4 \uC77C\uC815
        \uC2DC\uAC04\uB9C8\uB2E4 \uC790\uB3D9\uC73C\uB85C \uD3EC\uC778\uD2B8\uB97C
        \uBC8C\uC5B4 \uC900\uB2E8\uB2E4."
  - _id: 4
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "아래 가운데 버튼을 눌러 슬라임이 등장하는 시간과 최대 수를 업그레이드할 수 있어."
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "하단 패널을 잡고 좌우로 돌리면 다른 업그레이드로 바꿀 수 있단다."
  - _id: 5
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uADF8\uB9AC\uACE0 \uC704\uC758 \uAC8C\uC774\uC9C0\uAC00 \uBAA8\uB450
        \uCC28\uBA74 \uC0C8\uB85C\uC6B4 \uC2AC\uB77C\uC784\uC774 \uC790\uB3D9\uC73C\uB85C
        \uB4F1\uC7A5\uD574."
  - _id: 6
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "\uC774\uC81C \uC900\uBE44\uB294 \uB05D\uB0AC\uC5B4! \uC2AC\uB77C\uC784\uB4E4\uC744
        \uC798 \uD0A4\uC6CC \uB098\uAC00 \uBCF4\uC790!"
  - _id: 7
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "5레벨 슬라임을 해금해서 자연 생성되는 슬라임의 종류가 늘어났어!"
  - _id: 8
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "상위 슬라임 등장 확률 업그레이드로 높은 등급 슬라임이 자연 생성될 확률을 높일 수 있어."
    - _speaker: "선생님"
      _message: "업그레이드 레벨이 더 높아지면 자연 생성되는 슬라임의 종류가 더 다양해질지도...?"
    - _speaker: "선생님"
      _message: "새로운 슬라임들을 만나면서 재미있게 즐겨 줘!"
  - _id: 9
    _lines:
    - _speaker: "\uC120\uC0DD\uB2D8"
      _message: "11\uB2E8\uACC4 \uC2AC\uB77C\uC784\uC774 \uD558\uB298\uB85C \uC62C\uB77C\uAC00\uAE30
        \uC704\uD574 \uAE30\uB97C \uBAA8\uC73C\uACE0 \uC788\uC5B4!"
  - _id: 10
    _lines:
    - _speaker: "선생님"
      _message: "새로운 공간인 장식장이 열렸어! 마음에 드는 슬라임을 전시해 보자."
    - _speaker: "선생님"
      _message: "장식장에는 같은 종류의 슬라임을 한 마리만 보관할 수 있어."
  - _id: 11
    _lines:
    - _speaker: "선생님"
      _message: "장식장에 있는 슬라임은 어떤 방법으로도 포인트를 만들지 않아. 포인트를 얻으려면 꺼내기로 다시 유치원에 보내 줘."
    - _speaker: "선생님"
      _message: "이제 장식장도 마음껏 꾸미면서 재미있게 즐겨 줘!"
  - _id: 12
    _lines:
    - _speaker: "선생님"
      _message: "이 확률표에서 지금 자연 생성될 수 있는 슬라임의 종류와 각각의 등장 확률을 확인할 수 있어."
  _stageMenuButtonMessage: "\uD558\uB2E8 \uD328\uB110 \uC804\uD658 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC774\uB3D9 \uD328\uB110\uC744 \uC5F4\uC5B4 \uBCF4\uC790!"
  _stageButtonMessage: "\uC774 \uBC84\uD2BC\uC73C\uB85C \uB545\uACFC \uD558\uB298\uC744
    \uC624\uAC08 \uC218 \uC788\uC5B4!"
